# --- Required ---
MM_PRIVATE_KEY=0x...               # MM wallet private key for EIP-712 signing
MM_API_KEY=mm-key-...              # API key for /mm/* endpoints
BACKEND_URL=http://localhost:8000  # b1nary API base URL
RPC_URL=https://sepolia.base.org   # Base RPC for reading makerNonce

# --- Optional (defaults shown) ---
REFRESH_INTERVAL=60                # Seconds between quote refresh cycles
SPREAD_BPS=200                     # Spread in basis points (200 = 2%)
MAX_AMOUNT=10000000000             # Max oTokens per quote (8 decimals, 100 ETH)
DEADLINE_SECONDS=300               # Quote deadline duration
MIN_LAZY_QUOTE_TTL_SECONDS=180     # Covers backend's 150s create+execution reserve plus handoff margin
CHAIN_ID=84532                     # Chain ID for EIP-712 domain
BATCH_SETTLER=0x494E4F5b56Ed30bddB8D2d20300f3977623EB7bF  # Base Sepolia Circle USDC BatchSettler
RISK_FREE_RATE=0.05                # Annualized risk-free rate for BS pricing

# --- Capacity ---
MM_TYPE=internal                   # internal (full reporting) | external (minimal)
CAPACITY_RESERVE_RATIO=0.25        # Reserve buffer on hedge pool (0.25 = 25%)
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e  # Base Sepolia Circle USDC
MARGIN_POOL_ADDRESS=0xF3E58e6fed228179dD86fdd3a1A9Fe23A4980DA3  # Base Sepolia Circle USDC MarginPool

# --- Base Sepolia Circle USDC deployment reference ---
BASE_SEPOLIA_USDC=0x036CbD53842c5426634e7929541eC2318f3dCF7e
BASE_SEPOLIA_BATCH_SETTLER=0x494E4F5b56Ed30bddB8D2d20300f3977623EB7bF
BASE_SEPOLIA_MARGIN_POOL=0xF3E58e6fed228179dD86fdd3a1A9Fe23A4980DA3
BASE_SEPOLIA_VAULT_ADAPTER=0x28B953496815AF6404320522E2CB7b9A2b0a5F90
BASE_SEPOLIA_OTOKEN_FACTORY=0x9aD4a3824Ac9Dfb0983EC58a044b1D833B930144

# --- Base Sepolia CSP fund allocator (testnet only; disabled by default) ---
FUND_ALLOCATOR_ENABLED=false
FUND_ALLOCATOR_PRIVATE_KEY=0x...
FUND_ALLOCATOR_POLICY_PATH=policies/csp_fund_policy.v3.base-sepolia.json
FUND_ALLOCATOR_INTERVAL_SECONDS=30
FUND_ALLOCATOR_CONFIRMATIONS=2
FUND_OPERATIONS_KEEPER_ENABLED=false
FUND_PROCESSOR_PRIVATE_KEY=0x...
FUND_OPERATIONS_KEEPER_INTERVAL_SECONDS=30
FUND_OPERATIONS_KEEPER_PAGE_SIZE=16
FUND_VAULT_ADDRESS=0x...
FUND_FLOW_MANAGER_ADDRESS=0x...
FUND_STRATEGY_MANAGER_ADDRESS=0x...
FUND_CSP_ADAPTER_ADDRESS=0x...
# B1N-367 fair-NAV policy v2 only (model v1, 0 buffer, 5% max divergence).
FUND_CSP_VALUATOR_ADDRESS=0x...

# --- Base Sepolia Covered Call fund allocator (testnet only; disabled by default) ---
COVERED_CALL_ALLOCATOR_ENABLED=false
COVERED_CALL_ALLOCATOR_PRIVATE_KEY=0x...
COVERED_CALL_ALLOCATOR_POLICY_PATH=policies/covered_call_fund_policy.v5.base-sepolia.json
COVERED_CALL_ALLOCATOR_INTERVAL_SECONDS=30
COVERED_CALL_ALLOCATOR_CONFIRMATIONS=2
COVERED_CALL_OPERATIONS_KEEPER_ENABLED=false
COVERED_CALL_PROCESSOR_PRIVATE_KEY=0x...
COVERED_CALL_OPERATIONS_KEEPER_INTERVAL_SECONDS=30
COVERED_CALL_OPERATIONS_KEEPER_PAGE_SIZE=16
COVERED_CALL_VAULT_ADDRESS=0x...
COVERED_CALL_FLOW_MANAGER_ADDRESS=0x...
COVERED_CALL_STRATEGY_MANAGER_ADDRESS=0x...
COVERED_CALL_ADAPTER_ADDRESS=0x...
COVERED_CALL_VALUATOR_ADDRESS=0x...
COVERED_CALL_WETH_ADDRESS=0x...

# --- Base Sepolia Meta Wheel (testnet only; disabled by default) ---
# Keep disabled until the final deployment manifest and selector roles are verified.
META_WHEEL_ALLOCATOR_ENABLED=false
META_WHEEL_ALLOCATOR_PRIVATE_KEY=0x...
META_WHEEL_PROCESSOR_PRIVATE_KEY=0x...
META_WHEEL_ALLOCATOR_ADDRESS=0x...
META_WHEEL_PROCESSOR_ADDRESS=0x...
META_WHEEL_ALLOCATOR_POLICY_PATH=policies/meta_wheel_policy.v1.base-sepolia.json
META_WHEEL_APPROVED_POLICY_SHA256=
META_WHEEL_ALLOCATOR_INTERVAL_SECONDS=30
META_WHEEL_ALLOCATOR_CONFIRMATIONS=2
META_WHEEL_ACTION_JOURNAL_PATH=data/meta_wheel_actions.sqlite3
META_WHEEL_DEPLOYMENT_MANIFEST_PATH=
META_WHEEL_DEPLOYMENT_MANIFEST_SHA256=
META_WHEEL_PARENT_ADDRESS=0x...
META_WHEEL_STRATEGY_MANAGER_ADDRESS=0x...
META_WHEEL_COORDINATOR_ADDRESS=0x...
META_WHEEL_VALUATOR_ADDRESS=0x...
META_WHEEL_CSP_LANE_ADDRESSES=0x...
META_WHEEL_CALL_LANE_ADDRESSES=0x...

# --- Solana devnet (optional) ---
SOLANA_ASSETS=sol,tslax
SOLANA_TSLAX_MINT=H3sTci14zw4uVRNetdALKjv5KKHEab9M3rAJQ4BfhHaF
SOLANA_TSLAX_PYTH_FEED=47a156470288850a440df3a6ce85a55917b813a19bb5b31128a33a986566a362
TSLAX_HEDGE_SYMBOL=TSLAX
TSLAX_HEDGE_LEVERAGE=1
TSLAX_MAX_EXPOSURE=0.25
# Keep devnet TSLAx hedging simulated unless a real hedge venue is configured.
HEDGE_MODE=simulate

